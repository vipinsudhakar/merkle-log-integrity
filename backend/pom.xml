<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring Boot's parent POM is inherited from Phase 1 purely for DEPENDENCY MANAGEMENT
      (it pins consistent JUnit / AssertJ versions) and sensible plugin defaults.

      No Spring dependency is declared yet, and none should be until Phase 2. The Phase 1
      deliverable is pure DSA logic: the `core` and `chunking` packages must compile and be
      unit-testable with no Spring application context anywhere in sight. Inheriting the
      parent now simply avoids restructuring the build when the API layer arrives.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/> <!-- always resolve from the repository, not a parent directory -->
    </parent>

    <groupId>com.merklelog</groupId>
    <artifactId>merkle-log-integrity</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>merkle-log-integrity</name>
    <description>
        Merkle tree based tamper-evident log integrity verification, with a comparative
        analysis of fixed-size, time-window and entropy-based chunking strategies.
    </description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!--
          Test-only dependencies. We deliberately do NOT use spring-boot-starter-test here:
          it would drag the Spring context onto the test classpath and blur the boundary
          that Phase 1 is meant to keep sharp. Plain JUnit 5 + AssertJ is all the core
          logic needs.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
