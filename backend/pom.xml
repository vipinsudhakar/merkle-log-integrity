<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring Boot 3.5 (the latest 3.x line). Upgraded from 3.3.5, which is out of free support
      and whose managed Flyway predates PostgreSQL 18.

      Spring is used only by the `api` and `persistence` packages and the application class.
      `core`, `chunking`, `benchmark` and `demo` stay plain Java with zero Spring imports, so
      the data structures remain unit-testable with no application context (CLAUDE.md rule 3).
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- always resolve from the repository, not a parent directory -->
    </parent>

    <groupId>com.merklelog</groupId>
    <artifactId>merkle-log-integrity</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <name>merkle-log-integrity</name>
    <description>
        Merkle tree based tamper-evident log integrity verification with Content-Anchored
        Adaptive Chunking (CAAC), compared against fixed-size, time-window, entropy and the
        base paper's resource-aware chunking.
    </description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          Spring Boot 3.5 manages Flyway 11.7, which predates PostgreSQL 18 and warns that it is
          untested against it. The latest 11.x release (same major version, so the same API Boot
          expects) adds that support.
        -->
        <flyway.version>11.20.3</flyway.version>
    </properties>

    <dependencies>
        <!-- REST API for the visualiser. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- PostgreSQL: datasets, log entries and the trusted root anchor history. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          Tests. The data-structure tests use plain JUnit 5 + AssertJ and never start a Spring
          context; spring-boot-starter-test is only for the API tests.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!--
              The committed benchmark results, served by GET /api/benchmarks. Copied rather than
              recomputed at runtime: see docs/benchmarks/README.md.
            -->
            <resource>
                <directory>../docs/benchmarks</directory>
                <targetPath>benchmarks</targetPath>
                <includes>
                    <include>results.json</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.merklelog.MerkleLogApplication</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
