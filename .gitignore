# ---------- Java / Maven ----------
target/
*.class
*.ctxt
.mtj.tmp/

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
# ...but a Maven Wrapper jar must stay tracked if we ever add one
!.mvn/wrapper/maven-wrapper.jar

# JVM crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# ---------- Node / frontend (Phase 4+) ----------
node_modules/
dist/
dist-ssr/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Environment / secrets ----------
# Never commit real credentials. .env.example IS tracked, as the template.
.env
.env.*
!.env.example
# Local Spring overrides (database password); loaded automatically from backend/config/.
backend/config/
# The built frontend, copied into the jar only inside the Docker build.
backend/src/main/resources/static/

# ---------- Logs ----------
*.log
logs/

# ---------- Claude Code local settings ----------
# Personal per-machine overrides (attribution, permissions). Not team config.
.claude/settings.local.json

# ---------- IDE / OS ----------
.idea/
*.iml
.vscode/
!.vscode/extensions.json
.DS_Store
Thumbs.db
